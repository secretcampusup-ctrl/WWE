platform :ios, '16.0'

target 'VideoPlayer' do
  use_frameworks!
  # Required by VideoPlayerView (MKV / VLC path). Keep even when AVPlayer is default.
  # Keep the podspec in the repository so a fresh CI runner does not have to
  # enumerate MobileVLCKit versions through the CocoaPods CDN/GitHub mirror.
  pod 'MobileVLCKit', :podspec => File.expand_path('MobileVLCKit.podspec', __dir__)
  pod 'Kingfisher', '~> 8.0'
  pod 'KingfisherWebP', '~> 1.7'
  # Direct magnet fallback when no cloud/debrid provider is configured.
  # The binary is fetched by CocoaPods; it is not committed to this repository.
  pod 'TorrentBridgeKit', :podspec => File.expand_path('TorrentBridgeKit.podspec', __dir__)
end
